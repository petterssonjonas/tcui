# Maintainer: TermChatUI maintainers
# Release template. Run bash scripts/package.sh after building the release;
# use target/dist/PKGBUILD, which contains the version and real asset checksums.
pkgname=tcui-bin
pkgver='@VERSION@'
pkgrel=1
pkgdesc="ChatGPT-style terminal chat UI"
arch=('x86_64')
url='@REPOSITORY@'
license=('GPL-3.0-only' 'MIT')
depends=('glibc>=2.34' 'libgcc' 'ca-certificates')
optdepends=(
    'tmux: open Edit in a tmux split when available'
    'libnotify: desktop notifications through notify-send'
)
provides=("tcui=${pkgver}")
conflicts=('tcui' 'tcui-git')
options=('!debug' '!strip')
source=(
    "tcui-${pkgver}-x86_64.tar.gz::${url}/releases/download/v${pkgver}/tcui-x86_64-unknown-linux-gnu.tar.gz"
    "LICENSE::${url}/releases/download/v${pkgver}/LICENSE"
    "potion-base-8M-LICENSE::${url}/releases/download/v${pkgver}/potion-base-8M-LICENSE"
)
sha256sums=(
    '@TARBALL_SHA256@'
    '@LICENSE_SHA256@'
    '@MODEL_LICENSE_SHA256@'
)

package() {
    install -Dm755 "${srcdir}/tcui" "${pkgdir}/usr/bin/tcui"
    install -Dm644 "${srcdir}/LICENSE" "${pkgdir}/usr/share/licenses/${pkgname}/LICENSE"
    install -Dm644 "${srcdir}/potion-base-8M-LICENSE" \
        "${pkgdir}/usr/share/licenses/${pkgname}/potion-base-8M-LICENSE"
}