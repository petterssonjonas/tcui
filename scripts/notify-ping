#!/usr/bin/env python3
# /// script
# requires-python = ">=3.11"
# dependencies = []
# ///

# ─── How to run ───
# 1. Run: python3 notify-ping [OPTIONS] "message"
# 2. Or make executable and run: chmod +x notify-ping && ./notify-ping --help
# ──────────────────

from __future__ import annotations

import argparse
import base64
from dataclasses import dataclass
import json
import mimetypes
import os
from pathlib import Path
import re
import stat
import sys
import urllib.error
import urllib.parse
import urllib.request


API_URL = "https://api.pushover.net/1/messages.json"
MAX_ATTACHMENT_BYTES = 5_242_880
MAX_ENV_BYTES = 65_536
PRIORITIES = {"lowest": -2, "low": -1, "normal": 0, "high": 1, "emergency": 2}


@dataclass(frozen=True, slots=True)
class CliError(Exception):
    message: str

    def __str__(self) -> str:
        return self.message


def positive_int(raw: str) -> int:
    value = int(raw)
    if value <= 0:
        raise argparse.ArgumentTypeError("must be a positive integer")
    return value


def priority_value(raw: str) -> int:
    normalized = raw.lower()
    if normalized in PRIORITIES:
        return PRIORITIES[normalized]
    try:
        value = int(raw)
    except ValueError as error:
        raise argparse.ArgumentTypeError("use lowest, low, normal, high, emergency, or -2..2") from error
    if value not in range(-2, 3):
        raise argparse.ArgumentTypeError("priority must be between -2 and 2")
    return value


def parser() -> argparse.ArgumentParser:
    result = argparse.ArgumentParser(
        prog="notify-ping",
        description="Send a Pushover notification; environment or a private file avoids command-line secrets.",
        formatter_class=argparse.RawDescriptionHelpFormatter,
        epilog=(
            "Credentials are read from PUSHOVER_USER_KEY and PUSHOVER_APP_TOKEN, or\n"
            "PUSHOVER_<APP>_APP_TOKEN, in the environment or --env-file (mode 0600).\n"
            "Use --token-env NAME to select another token variable.\n"
            "--user-key / --app-key override environment/file values but appear in process arguments."
        ),
    )
    result.add_argument("message", nargs="?", help="message body; omit to read stdin")
    result.add_argument("--app", default="default", help="named application profile (default: default)")
    result.add_argument("--env-file", type=Path, help="secret env file (default: $PUSHOVER_ENV_FILE or ~/.config/opencode/pushover.env)")
    result.add_argument("--token-env", help="environment variable containing the application token")
    result.add_argument("--user-key", help="explicit Pushover user key (visible in process arguments)")
    result.add_argument("--app-key", help="explicit application token (visible in process arguments)")
    result.add_argument("--title")
    result.add_argument("--priority", "--importance", type=priority_value, default=0)
    result.add_argument("--sound")
    result.add_argument("--device", help="device name, or comma-separated device names")
    result.add_argument("--url")
    result.add_argument("--url-title")
    result.add_argument("--timestamp", type=int, help="Unix timestamp shown by Pushover")
    result.add_argument("--ttl", type=positive_int, help="seconds before automatic deletion")
    result.add_argument("--retry", type=positive_int, help="emergency retry interval, at least 30 seconds")
    result.add_argument("--expire", type=positive_int, help="emergency retry duration, at most 10800 seconds")
    formatting = result.add_mutually_exclusive_group()
    formatting.add_argument("--html", action="store_true")
    formatting.add_argument("--monospace", action="store_true")
    result.add_argument("--attachment", type=Path, help="one image, at most 5 MiB")
    result.add_argument("--dry-run", action="store_true", help="validate and print a redacted request without sending")
    return result


def read_env_file(path: Path, names: set[str] | None = None) -> dict[str, str]:
    try:
        descriptor = os.open(path, os.O_RDONLY | os.O_NOFOLLOW | os.O_NONBLOCK)
    except FileNotFoundError:
        return {}
    except OSError as error:
        raise CliError("cannot open private credential file") from error
    with os.fdopen(descriptor, "rb") as stream:
        metadata = os.fstat(stream.fileno())
        if not stat.S_ISREG(metadata.st_mode) or stat.S_IMODE(metadata.st_mode) != 0o600 or metadata.st_uid != os.geteuid():
            raise CliError("secret file must be user-owned, regular, and mode 0600 (run chmod 600)")
        if metadata.st_size > MAX_ENV_BYTES:
            raise CliError("secret file exceeds 64 KiB")
        raw = stream.read(MAX_ENV_BYTES + 1)
    if len(raw) > MAX_ENV_BYTES:
        raise CliError("secret file exceeds 64 KiB")
    try:
        text = raw.decode("utf-8")
    except UnicodeDecodeError as error:
        raise CliError("secret file must contain UTF-8 text") from error
    values: dict[str, str] = {}
    for raw_line in text.splitlines():
        line = raw_line.strip()
        if not line or line.startswith("#"):
            continue
        if line.startswith("export "):
            line = line[7:].lstrip()
        key, separator, value = line.partition("=")
        if names is not None and key not in names:
            continue
        if not separator or not re.fullmatch(r"[A-Za-z_][A-Za-z0-9_]*", key):
            raise CliError("invalid secret file assignment")
        value = value.strip()
        if value.startswith(("'", '"')):
            if len(value) < 2 or value[-1] != value[0]:
                raise CliError("invalid quoted secret file value")
            value = value[1:-1]
        if any(ord(char) < 32 for char in value) or (
            not key.endswith("_TITLE") and any(char in "$`;|&\\\\'\"" for char in value)
        ):
            raise CliError("secret file accepts literal credential values only, not shell expressions")
        if key in values:
            raise CliError("duplicate secret file assignment")
        values[key] = value
    return values


def add(payload: dict[str, str], name: str, value: str | int | None) -> None:
    if value is not None and value != "":
        payload[name] = str(value)


def validate(args: argparse.Namespace, message: str) -> None:
    limits = ((message, 1024, "message"), (args.title, 250, "title"), (args.url, 512, "URL"), (args.url_title, 100, "URL title"))
    for value, limit, label in limits:
        if value is not None and len(value) > limit:
            raise CliError(f"{label} exceeds Pushover's {limit}-character limit")
    if args.url_title and not args.url:
        raise CliError("--url-title requires --url")
    if args.timestamp is not None and args.timestamp < 0:
        raise CliError("--timestamp must be zero or greater")
    if args.device:
        invalid = [name for name in args.device.split(",") if not re.fullmatch(r"[A-Za-z0-9_-]{1,25}", name)]
        if invalid:
            raise CliError("--device names must be 1-25 characters from A-Z, a-z, 0-9, _ or -")
    emergency = args.priority == 2
    if emergency and (args.retry is None or args.expire is None):
        raise CliError("emergency priority requires both --retry and --expire")
    if not emergency and (args.retry is not None or args.expire is not None):
        raise CliError("--retry and --expire require emergency priority")
    if args.retry is not None and args.retry < 30:
        raise CliError("--retry must be at least 30 seconds")
    if args.expire is not None and args.expire > 10800:
        raise CliError("--expire must be at most 10800 seconds")
    if emergency and args.ttl is not None:
        raise CliError("--ttl cannot be used with emergency priority")


def attachment_fields(path: Path | None) -> dict[str, str]:
    if path is None:
        return {}
    if not path.is_file():
        raise CliError(f"attachment is not a readable file: {path}")
    if path.stat().st_size > MAX_ATTACHMENT_BYTES:
        raise CliError("attachment exceeds Pushover's 5 MiB limit")
    media_type = mimetypes.guess_type(path.name)[0]
    if media_type is None or not media_type.startswith("image/"):
        raise CliError("attachment must have a recognized image file extension")
    return {
        "attachment_base64": base64.b64encode(path.read_bytes()).decode("ascii"),
        "attachment_type": media_type,
    }


def build_payload(args: argparse.Namespace) -> dict[str, str]:
    message = args.message if args.message is not None else sys.stdin.read().rstrip("\n")
    if not message:
        raise CliError("message is required (argument or stdin)")
    validate(args, message)
    default_env_file = Path.home() / ".config/opencode/pushover.env"
    configured_env = os.environ.get("PUSHOVER_ENV_FILE")
    env_file = args.env_file or Path(configured_env or default_env_file)
    app_key = re.sub(r"[^A-Za-z0-9]", "_", args.app).upper()
    token_name = args.token_env or f"PUSHOVER_{app_key}_APP_TOKEN"
    names = {"PUSHOVER_USER_KEY", token_name, "PUSHOVER_APP_TOKEN", f"PUSHOVER_{app_key}_TITLE"}
    # An explicit empty variable lets trusted callers disable all ambient file reads.
    settings = {} if args.env_file is None and configured_env == "" else read_env_file(env_file, names)
    settings.update({name: os.environ[name] for name in names if name in os.environ})
    token = args.app_key if args.app_key is not None else settings.get(token_name) or settings.get("PUSHOVER_APP_TOKEN")
    user = args.user_key if args.user_key is not None else settings.get("PUSHOVER_USER_KEY")
    if not user:
        raise CliError(f"missing PUSHOVER_USER_KEY in environment or {env_file}")
    if not token:
        raise CliError(f"missing {token_name} or PUSHOVER_APP_TOKEN in environment or {env_file}")
    if not re.fullmatch(r"[A-Za-z0-9]{30}", user) or not re.fullmatch(r"[A-Za-z0-9]{30}", token):
        raise CliError("Pushover keys must contain exactly 30 ASCII letters or digits")
    profile_title = settings.get(f"PUSHOVER_{app_key}_TITLE")
    legacy_titles = {"default": "Ping", "opencode": "OpenCode"}
    title = args.title or profile_title or legacy_titles.get(args.app, args.app.replace("-", " ").title())
    payload = {"token": token, "user": user, "message": message, "priority": str(args.priority), "title": title}
    for name in ("sound", "device", "url", "url_title", "timestamp", "ttl", "retry", "expire"):
        add(payload, name, getattr(args, name))
    if args.html:
        payload["html"] = "1"
    if args.monospace:
        payload["monospace"] = "1"
    payload.update(attachment_fields(args.attachment))
    return payload


def send(payload: dict[str, str]) -> dict[str, str | int]:
    request = urllib.request.Request(
        API_URL,
        data=urllib.parse.urlencode(payload).encode("utf-8"),
        headers={"Content-Type": "application/x-www-form-urlencoded", "User-Agent": "notify-ping/1"},
        method="POST",
    )
    try:
        with urllib.request.urlopen(request, timeout=10) as response:
            raw = response.read()
    except urllib.error.HTTPError as error:
        raise CliError(f"Pushover rejected the request (HTTP {error.code})") from error
    except urllib.error.URLError as error:
        raise CliError("could not reach Pushover") from error
    try:
        result = json.loads(raw)
    except json.JSONDecodeError as error:
        raise CliError("Pushover returned an invalid response") from error
    if not isinstance(result, dict) or result.get("status") != 1:
        raise CliError("Pushover rejected the request")
    return result


def main() -> int:
    args = parser().parse_args()
    try:
        payload = build_payload(args)
        if args.dry_run:
            safe = payload | {"token": "<redacted>", "user": "<redacted>"}
            if "attachment_base64" in safe:
                safe["attachment_base64"] = f"<{len(payload['attachment_base64'])} base64 characters>"
            print(json.dumps(safe, indent=2, sort_keys=True))
            return 0
        result = send(payload)
    except CliError as error:
        parser().error(str(error))
    receipt = result.get("receipt")
    suffix = f" (receipt {receipt})" if receipt else ""
    print(f"notify-ping: sent{suffix}")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
